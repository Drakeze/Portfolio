# MongoDB Atlas connection string with explicit database name
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-host>/<database_name>?retryWrites=true&w=majority"

# Optional Prisma query logging levels: query,info,warn,error
PRISMA_LOG_LEVEL="error"

# Comma-separated admin emails allowed to access /admin
ADMIN_EMAILS="you@example.com"

# Better Auth secret used to sign sessions and tokens
BETTER_AUTH_SECRET="<generate-a-long-random-secret>"

# Public app URL used for Better Auth callback links
BETTER_AUTH_URL="http://localhost:3000"

# Resend API key for sending contact emails
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxx"

# Optional: recipient for portfolio contact notifications
CONTACT_TO_EMAIL="you@example.com"

# Optional: sender identity (must be valid in your Resend account/domain)
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
