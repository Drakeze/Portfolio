# MongoDB Atlas connection string with explicit database name
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-host>/<database_name>?retryWrites=true&w=majority"

# Optional Prisma query logging levels: query,info,warn,error
PRISMA_LOG_LEVEL="error"

# Admin password used for the lightweight /admin login
ADMIN_PASSWORD="<choose-a-strong-password>"

# Optional secret used to sign the admin session cookie
ADMIN_SESSION_SECRET="<generate-a-long-random-secret>"

# Resend API key for sending contact emails
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxx"

# Optional: recipient for portfolio contact notifications
CONTACT_TO_EMAIL="you@example.com"

# Optional: sender identity (must be valid in your Resend account/domain)
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Cloudflare R2 — used for resume PDF uploads via the admin panel
# Create an R2 bucket in the Cloudflare dashboard, then generate an API token
# with Object Read & Write permissions scoped to that bucket.
CLOUDFLARE_ACCOUNT_ID="<your-cloudflare-account-id>"
R2_ACCESS_KEY_ID="<r2-api-token-access-key-id>"
R2_SECRET_ACCESS_KEY="<r2-api-token-secret-access-key>"
R2_BUCKET_NAME="<your-bucket-name>"
# Public URL for the bucket (set up a custom domain or use the r2.dev subdomain)
R2_PUBLIC_URL="https://<bucket-or-custom-domain>"
