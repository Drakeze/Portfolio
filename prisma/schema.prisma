// Prisma setup for this consumer app.
// The canonical portfolio schema lives in the shared database repository.
// If typed Prisma model delegates are ever needed here, sync them from the
// shared source of truth instead of redefining models locally in this repo.

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}
